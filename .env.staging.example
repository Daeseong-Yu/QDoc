APP_DOMAIN="example.com"
APP_URL="https://example.com"
APP_ENV="staging"
QDOC_APP_IMAGE="qdoc-app:replace-with-git-sha"
QDOC_WEB_BIND="127.0.0.1"
QDOC_WEB_PORT="13000"
ALLOW_CONSOLE_OTP="false"
ALLOW_FIXED_OTP="false"
FIXED_OTP_EMAIL=""
FIXED_OTP_CODE=""
EMAIL_PROVIDER="smtp"
EMAIL_FROM="QDoc <no-reply@example.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_USER="replace-with-smtp-user"
SMTP_PASS="replace-with-smtp-password"

POSTGRES_DB="qdoc"
POSTGRES_USER="qdoc"
QDOC_DB_SECRET="replace-with-deploy-db-secret"
DATABASE_URL="postgresql://qdoc:replace-with-deploy-db-secret@postgres:5432/qdoc?schema=public"

REDIS_URL="redis://redis:6379"
OTP_REQUEST_PAIR_LIMIT_PER_MINUTE="1"
OTP_REQUEST_EMAIL_LIMIT_PER_HOUR="5"
OTP_REQUEST_EMAIL_LIMIT_PER_DAY="20"
OTP_REQUEST_IP_LIMIT_PER_MINUTE="10"
OTP_REQUEST_IP_LIMIT_PER_HOUR="100"
OTP_VERIFY_PAIR_LIMIT_PER_MINUTE="5"
OTP_VERIFY_EMAIL_LIMIT_PER_HOUR="30"
OTP_VERIFY_IP_LIMIT_PER_HOUR="120"

SESSION_SECRET="replace-with-a-long-random-session-secret"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_OUTBOX_BATCH_SIZE="10"
WORKER_OUTBOX_MAX_ATTEMPTS="5"
QDOC_SEED_STAFF_ADMIN_EMAILS=""
QDOC_BOOTSTRAP_STAFF_ADMIN_EMAILS=""
QDOC_BOOTSTRAP_STAFF_SITE_IDS="site-waterloo,site-kitchener"
QDOC_BOOTSTRAP_STAFF_CONFIRM=""
QDOC_ADMIN_DATA_EXPECT_SITE_IDS="site-waterloo,site-kitchener"
QDOC_ADMIN_DATA_EXPECT_STAFF_ADMIN_EMAILS=""
MAP_PROVIDER=""
MAP_PROVIDER_ENABLED="false"
MAP_MONTHLY_MAP_LOAD_LIMIT="0"
MAP_MONTHLY_PLACES_SEARCH_LIMIT="0"
MAP_SETTINGS_ADMIN_EMAILS=""
MAPBOX_PUBLIC_TOKEN=""
MAPBOX_SEARCH_TOKEN=""
GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_PLACES_SERVER_KEY=""
MAP_USAGE_RATE_LIMIT_PER_MINUTE="30"
MAP_USAGE_RATE_LIMIT_PER_HOUR="300"
MAP_SEARCH_RATE_LIMIT_PER_MINUTE="10"
MAP_SEARCH_RATE_LIMIT_PER_HOUR="100"
MAP_SEARCH_CACHE_TTL_SECONDS="600"
