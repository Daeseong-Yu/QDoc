generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  waiting
  called
  in_service
  completed
  delay
  cancelled
}

enum MembershipRole {
  staff
  admin
}

enum MapProvider {
  mapbox
  google
}

enum MapUsageType {
  map_load
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  sites     Site[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id                 String         @id @default(cuid())
  organizationId     String
  name               String
  distanceKm         Float          @default(0)
  notificationAheadCount Int        @default(2)
  addressLine1       String?
  city               String?
  region             String?
  postalCode         String?
  country            String?
  latitude           Float?
  longitude          Float?
  locationSource     String?
  locationVerifiedAt DateTime?
  organization       Organization   @relation(fields: [organizationId], references: [id])
  queues             Queue[]
  memberships        Membership[]
  tickets            Ticket[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Queue {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  isOpen    Boolean  @default(true)
  site      Site     @relation(fields: [siteId], references: [id])
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, createdAt])
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailNotificationsEnabled Boolean @default(true)
  memberships     Membership[]
  patientProfile  PatientProfile?
  otpChallenges   OtpChallenge[]
  tickets         Ticket[]
  auditLogs       AuditLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  siteId    String
  role      MembershipRole @default(staff)
  user      User           @relation(fields: [userId], references: [id])
  site      Site           @relation(fields: [siteId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, siteId])
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
}

model Ticket {
  id          String            @id @default(cuid())
  siteId      String
  queueId     String
  userId      String
  status      TicketStatus      @default(waiting)
  site        Site              @relation(fields: [siteId], references: [id])
  queue       Queue             @relation(fields: [queueId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  events      TicketEvent[]
  notifications NotificationLog[]
  sortRank    DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([siteId, status, createdAt])
  @@index([siteId, status, queueId, createdAt])
  @@index([siteId, status, queueId, sortRank])
}

model TicketEvent {
  id        String       @id @default(cuid())
  ticketId  String
  status    TicketStatus
  note      String?
  ticket    Ticket       @relation(fields: [ticketId], references: [id])
  createdAt DateTime     @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  ticketId  String?
  channel   String
  message   String
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  createdAt DateTime @default(now())
}

model Outbox {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  metadata  Json?
  actor     User?    @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
}

model MapProviderConfig {
  id                  String      @id @default(cuid())
  provider            MapProvider @unique
  isEnabled           Boolean     @default(false)
  monthlyMapLoadLimit Int         @default(0)
  hardStopEnabled     Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model MapProviderConfigAudit {
  id                             String      @id @default(cuid())
  provider                       MapProvider
  action                         String
  actorId                        String?
  isEnabledBefore                Boolean?
  isEnabledAfter                 Boolean?
  monthlyMapLoadLimitBefore      Int?
  monthlyMapLoadLimitAfter       Int?
  hardStopEnabledBefore          Boolean?
  hardStopEnabledAfter           Boolean?
  metadata                       Json?
  createdAt                      DateTime    @default(now())

  @@index([provider, createdAt])
  @@index([actorId, createdAt])
}

model MapUsagePeriod {
  id            String       @id @default(cuid())
  provider      MapProvider
  usageType     MapUsageType @default(map_load)
  periodStart   DateTime
  limit         Int
  used          Int          @default(0)
  hardStoppedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([provider, usageType, periodStart])
  @@index([provider, usageType, periodStart])
}
